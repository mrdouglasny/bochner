open scoped RealInnerProductSpace ENNReal ComplexOrder

/-- **`exp (-Q / 2)` is positive-definite** for a positive quadratic form `Q` on a real vector
space: at finitely many points `xᵢ` it is the characteristic function of the centred Gaussian on
`ℝᵏ` whose covariance is the Gram matrix `(Q.associated xᵢ xⱼ)`, taken at the points `eᵢ`. -/
theorem posSemidef_circulant_exp_neg_half {V : Type*} [AddCommGroup V] [Module ℝ V]
    {Q : QuadraticForm ℝ V} (hpos : ∀ x, 0 ≤ Q x) :
    (circulant fun x ↦ (Real.exp (-(Q x / 2)) : ℂ)).PosSemidef := by
  classical
  refine posSemidef_iff_forall_fin.2 fun k x ↦ ?_
  set B := QuadraticMap.associated (R := ℝ) Q with hB
  have hBQ : ∀ y, B y y = Q y := QuadraticMap.associated_eq_self_apply ℝ Q
  have hBsymm : ∀ u v, B u v = B v u := fun u v ↦ by
    rw [hB, QuadraticMap.associated_apply, QuadraticMap.associated_apply, add_comm u v,
      sub_right_comm]
  set S : Matrix (Fin k) (Fin k) ℝ := Matrix.of fun i j ↦ B (x i) (x j) with hS
  have hSpos : S.PosSemidef := by
    refine posSemidef_iff_dotProduct_mulVec.2 ⟨IsHermitian.ext fun i j ↦ ?_, fun c ↦ ?_⟩
    · simp [hS, hBsymm (x i) (x j)]
    · have : star c ⬝ᵥ S *ᵥ c = Q (∑ i, c i • x i) := by
        rw [← hBQ]
        simp only [hS, dotProduct, mulVec, map_sum, map_smul, LinearMap.sum_apply,
          LinearMap.smul_apply, smul_eq_mul, of_apply, star_trivial, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ ↦ Finset.sum_congr rfl fun j _ ↦ ?_
        rw [hBsymm (x i) (x j)]
        ring
      rw [this]
      exact hpos _
  set e : Fin k → EuclideanSpace ℝ (Fin k) := fun i ↦ EuclideanSpace.single i 1 with he
  have heq : (circulant fun x ↦ (Real.exp (-(Q x / 2)) : ℂ)).submatrix x x =
      (circulant (charFun (multivariateGaussian 0 S))).submatrix e e := by
    ext i j
    simp only [submatrix_apply, circulant_apply, charFun_multivariateGaussian hSpos]
    have hq : (e i - e j).ofLp ⬝ᵥ S *ᵥ (e i - e j).ofLp = Q (x i - x j) := by
      rw [← hBQ]
      simp only [map_sub, LinearMap.sub_apply]
      simp [he, hS, dotProduct, mulVec, Finset.sum_sub_distrib, sub_mul, mul_sub]
    rw [hq, inner_zero_right, ofReal_zero, zero_mul, zero_sub, Complex.ofReal_exp]
    congr 1
    push_cast
    rfl
  rw [heq]
  exact (posSemidef_circulant_charFun _).submatrix e

namespace MeasureTheory

section MinlosLemma

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
  [MeasurableSpace V] [BorelSpace V]

/-- **Minlos's lemma** [Bourbaki, *INT*, IX, §6, no. 9, Prop. 10]: if `1 - Re ν̂ ≤ ε + ∑ₙ ⟪wₙ, ·⟫²`
with `⟪wₙ, ·⟫² ≤ cₙ² h`, then `ν` puts mass at most `3 (ε + ∑ₙ cₙ² / r²)` outside the ellipsoid
`{t | ∀ a, ⟪a, t⟫² ≤ r² h a}`. Bourbaki's `Tr (q / h)` is bounded here by `∑ₙ cₙ²`. -/
theorem measure_setOf_exists_lt_inner_sq_le {ν : Measure V} [IsProbabilityMeasure ν]
    {h : QuadraticForm ℝ V} (hpos : ∀ a, 0 ≤ h a) {ε : ℝ}
    {w : ℕ → V} {c : ℕ → ℝ} (hc : Summable fun n ↦ c n ^ 2)
    (hw : ∀ n a, ⟪w n, a⟫ ^ 2 ≤ c n ^ 2 * h a)
    (hν : ∀ a, 1 - (charFun ν a).re ≤ ε + ∑' n, ⟪w n, a⟫ ^ 2) {r : ℝ} (hr : 0 < r) :
    ν {t | ∃ a, r ^ 2 * h a < ⟪a, t⟫ ^ 2} ≤
      ENNReal.ofReal (3 * (ε + (∑' n, c n ^ 2) / r ^ 2)) := by
  classical
  -- the associated symmetric bilinear form, `B a a = h a`
  set B := QuadraticMap.associated h with hBdef
  have hBh : ∀ a, B a a = h a := QuadraticMap.associated_eq_self_apply ℝ h
  -- `h` is bounded, so `∑ ‖w n‖² < ∞`
  obtain ⟨M, hM⟩ : ∃ M, ∀ a, h a ≤ M * ‖a‖ ^ 2 := by
    let H : V →L[ℝ] V →L[ℝ] ℝ := LinearMap.toContinuousLinearMap
      (LinearMap.toContinuousLinearMap.toLinearMap ∘ₗ B)
    refine ⟨‖H‖, fun a ↦ ?_⟩
    have := (H a).le_opNorm a
    have h2 := H.le_opNorm a
    calc h a = H a a := (hBh a).symm
      _ ≤ ‖H a a‖ := Real.le_norm_self _
      _ ≤ ‖H a‖ * ‖a‖ := this
      _ ≤ ‖H‖ * ‖a‖ * ‖a‖ := by gcongr
      _ = ‖H‖ * ‖a‖ ^ 2 := by ring
  have hwsum : Summable fun n ↦ ‖w n‖ ^ 2 := by
    refine (hc.mul_right (max M 0)).of_nonneg_of_le (fun n ↦ sq_nonneg _) fun n ↦ ?_
    have h1 := hw n (w n)
    rw [real_inner_self_eq_norm_sq] at h1
    rcases eq_or_ne ‖w n‖ 0 with h0 | h0
    · rw [h0, zero_pow two_ne_zero]; positivity
    have h3 : ‖w n‖ ^ 2 * ‖w n‖ ^ 2 ≤ c n ^ 2 * max M 0 * ‖w n‖ ^ 2 := by
      calc ‖w n‖ ^ 2 * ‖w n‖ ^ 2 = (‖w n‖ ^ 2) ^ 2 := by ring
        _ ≤ c n ^ 2 * h (w n) := h1
        _ ≤ c n ^ 2 * (max M 0 * ‖w n‖ ^ 2) := by
            gcongr; exact (hM _).trans (by gcongr; exact le_max_left _ _)
        _ = c n ^ 2 * max M 0 * ‖w n‖ ^ 2 := by ring
    exact le_of_mul_le_mul_right h3 (by positivity)
  -- an `h`-orthogonal basis; `h` and the pairing in its coordinates
  obtain ⟨b, hb⟩ := LinearMap.BilinForm.exists_orthogonal_basis
    (QuadraticForm.associated_isSymm ℝ h)
  set δ := fun k ↦ h (b k) with hδ
  have hδ0 : ∀ k, 0 ≤ δ k := fun k ↦ hpos _
  have hdiag : ∀ a, h a = ∑ k, b.repr a k ^ 2 * δ k := fun a ↦ by
    simp_rw [hδ, ← hBh]
    conv_lhs => rw [← b.sum_repr a]
    simp only [map_sum, map_smul, LinearMap.sum_apply, LinearMap.smul_apply, smul_eq_mul]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    rw [Finset.sum_eq_single k (fun l _ hlk ↦ by rw [hb hlk, mul_zero])
      (by simp)]
    ring
  have hpair : ∀ a t, ⟪a, t⟫ = ∑ k, b.repr a k * ⟪b k, t⟫ := fun a t ↦ by
    conv_lhs => rw [← b.sum_repr a]
    rw [sum_inner]
    simp_rw [real_inner_smul_left]
  -- the maps `A l t = (λₖ ⟪bₖ, t⟫)ₖ`, `λₖ = 1 / (r √δₖ)` where `h` is definite and `l` where not
  set lam : ℕ → Fin (Module.finrank ℝ V) → ℝ := fun l k ↦
    if 0 < δ k then (r * √(δ k))⁻¹ else l with hlam
  set A : ℕ → V →L[ℝ] EuclideanSpace ℝ (Fin (Module.finrank ℝ V)) := fun l ↦
    (EuclideanSpace.equiv (Fin _) ℝ).symm.toContinuousLinearMap ∘L
      ContinuousLinearMap.pi fun k ↦ lam l k • innerSL ℝ (b k) with hA
  have hAn : ∀ l t, ‖A l t‖ ^ 2 = ∑ k, (lam l k * ⟪b k, t⟫) ^ 2 := fun l t ↦ by
    rw [EuclideanSpace.real_norm_sq_eq]
    rfl
  -- `∑ₖ (λₖ ⟪bₖ, wₙ⟫)² ≤ cₙ² / r²`: nothing where `h` degenerates, dual Bessel where it does not
  have hsq_le : ∀ l n, ∑ k, (lam l k * ⟪b k, w n⟫) ^ 2 ≤ c n ^ 2 / r ^ 2 := fun l n ↦ by
    set f : Fin (Module.finrank ℝ V) → ℝ := fun k ↦ if 0 < δ k then ⟪b k, w n⟫ / δ k else 0
      with hf
    set σ := ∑ k, (if 0 < δ k then ⟪b k, w n⟫ ^ 2 / δ k else 0) with hσ
    have hterm : ∀ k, (lam l k * ⟪b k, w n⟫) ^ 2 =
        (if 0 < δ k then ⟪b k, w n⟫ ^ 2 / δ k else 0) / r ^ 2 := fun k ↦ by
      by_cases hk : 0 < δ k
      · simp only [hlam, ite_eq_left hk]
        rw [mul_pow, inv_pow, mul_pow, Real.sq_sqrt hk.le]
        field_simp
      · have h0 : δ k = 0 := le_antisymm (not_lt.1 hk) (hδ0 k)
        have := hw n (b k)
        have hk0 : h (b k) = 0 := h0
        rw [real_inner_comm, hk0, mul_zero] at this
        have hz : ⟪b k, w n⟫ = 0 :=
          pow_eq_zero_iff two_ne_zero |>.1 (le_antisymm this (sq_nonneg _))
        simp [hlam, hk, hz]
    have hrepr : ∀ k, b.repr (b.equivFun.symm f) k = f k := fun k ↦ by
      rw [← b.equivFun_apply, LinearEquiv.apply_symm_apply]
    have h1 : ⟪w n, b.equivFun.symm f⟫ = σ := by
      rw [real_inner_comm, hpair]
      refine Finset.sum_congr rfl fun k _ ↦ ?_
      rw [hrepr]
      simp only [hf]
      split_ifs <;> ring
    have h2 : h (b.equivFun.symm f) = σ := by
      rw [hdiag]
      refine Finset.sum_congr rfl fun k _ ↦ ?_
      rw [hrepr]
      simp only [hf]
      split_ifs with hk
      · field_simp
      · ring
    have hσ0 : 0 ≤ σ := Finset.sum_nonneg fun k _ ↦ by
      split_ifs with hk
      · exact div_nonneg (sq_nonneg _) hk.le
      · exact le_rfl
    have hσc : σ ≤ c n ^ 2 := by
      have := hw n (b.equivFun.symm f)
      rw [h1, h2] at this
      rcases hσ0.eq_or_lt with h0 | hpos'
      · rw [← h0]; positivity
      · nlinarith
    rw [Finset.sum_congr rfl fun k _ ↦ hterm k, ← Finset.sum_div, ← hσ]
    gcongr
  -- the Gaussian bound, for every `l`
  have hbound : ∀ l, ν {t | 1 ≤ ‖A l t‖} ≤
      ENNReal.ofReal (3 * (ε + (∑' n, c n ^ 2) / r ^ 2)) := fun l ↦ by
    refine (measure_one_le_norm_le_of_charFun hwsum hν (A l)).trans
      (ENNReal.ofReal_le_ofReal ?_)
    have hs : Summable fun n ↦ c n ^ 2 / r ^ 2 := hc.div_const _
    have hle : ∀ n, ‖A l (w n)‖ ^ 2 ≤ c n ^ 2 / r ^ 2 := fun n ↦
      (hAn l (w n)).trans_le (hsq_le l n)
    have := (hs.of_nonneg_of_le (fun _ ↦ sq_nonneg _) hle).tsum_le_tsum hle hs
    rw [tsum_div_const] at this
    linarith
  -- the increasing sets `{1 ≤ ‖A l t‖}` exhaust the complement of the ellipsoid
  have hmono : Monotone fun l : ℕ ↦ {t : V | 1 ≤ ‖A l t‖} := fun l l' hll' t ht ↦ by
    have ht : (1 : ℝ) ≤ ‖A l t‖ := ht
    change 1 ≤ ‖A l' t‖
    have h1 : ‖A l t‖ ^ 2 ≤ ‖A l' t‖ ^ 2 := by
      rw [hAn, hAn]
      refine Finset.sum_le_sum fun k _ ↦ ?_
      simp only [hlam]
      split_ifs
      · exact le_rfl
      · rw [mul_pow, mul_pow]
        gcongr
    nlinarith [norm_nonneg (A l t), norm_nonneg (A l' t)]
  have hsub : {t | ∃ a, r ^ 2 * h a < ⟪a, t⟫ ^ 2} ⊆ ⋃ l : ℕ, {t | 1 ≤ ‖A l t‖} := by
    rintro t ⟨a, ha⟩
    by_cases hex : ∃ k, ¬ 0 < δ k ∧ ⟪b k, t⟫ ≠ 0
    · obtain ⟨k, hk, hkt⟩ := hex
      obtain ⟨l, hl⟩ := exists_nat_gt (1 / |⟪b k, t⟫|)
      refine Set.mem_iUnion.2 ⟨l, ?_⟩
      change 1 ≤ ‖A l t‖
      have hlt : 1 < (l : ℝ) * |⟪b k, t⟫| := by
        rwa [div_lt_iff₀ (abs_pos.2 hkt)] at hl
      have h1 : 1 ≤ ‖A l t‖ ^ 2 := by
        rw [hAn]
        refine le_trans ?_ (Finset.single_le_sum (fun j _ ↦ sq_nonneg (lam l j * ⟪b j, t⟫))
          (Finset.mem_univ k))
        simp only [hlam, ite_eq_right hk]
        rw [mul_pow, ← sq_abs ⟪b k, t⟫]
        nlinarith [abs_nonneg ⟪b k, t⟫]
      nlinarith [norm_nonneg (A l t)]
    · push Not at hex
      refine Set.mem_iUnion.2 ⟨0, ?_⟩
      set v : Fin (Module.finrank ℝ V) → ℝ := fun k ↦
        if 0 < δ k then ⟪b k, t⟫ / √(δ k) else 0 with hv
      have hat : ⟪a, t⟫ = ∑ k, b.repr a k * √(δ k) * v k := by
        rw [hpair]
        refine Finset.sum_congr rfl fun k _ ↦ ?_
        by_cases hk : 0 < δ k
        · simp only [hv, ite_eq_left hk]
          field_simp [(Real.sqrt_pos.2 hk).ne']
        · simp [hv, hk, hex k (not_lt.1 hk)]
      have hh : ∑ k, (b.repr a k * √(δ k)) ^ 2 = h a := by
        rw [hdiag]
        refine Finset.sum_congr rfl fun k _ ↦ ?_
        rw [mul_pow, Real.sq_sqrt (hδ0 k)]
      have hcs := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ (fun k ↦ b.repr a k * √(δ k)) v
      rw [← hat, hh] at hcs
      have hv2 : r ^ 2 < ∑ k, v k ^ 2 := by
        have hpos'' : 0 < h a := by
          by_contra hle
          have h0 : h a = 0 := le_antisymm (not_lt.1 hle) (hpos a)
          rw [h0] at hcs ha
          nlinarith [sq_nonneg ⟪a, t⟫]
        nlinarith
      have hA0 : ‖A 0 t‖ ^ 2 = (∑ k, v k ^ 2) / r ^ 2 := by
        rw [hAn, Finset.sum_div]
        refine Finset.sum_congr rfl fun k _ ↦ ?_
        by_cases hk : 0 < δ k
        · simp only [hlam, hv, ite_eq_left hk]
          rw [mul_pow, div_pow, inv_pow, mul_pow, Real.sq_sqrt hk.le]
          field_simp
        · simp [hlam, hv, hk]
      change 1 ≤ ‖A 0 t‖
      have : 1 ≤ ‖A 0 t‖ ^ 2 := by
        rw [hA0, le_div_iff₀ (by positivity)]
        linarith
      nlinarith [norm_nonneg (A 0 t)]
  calc ν {t | ∃ a, r ^ 2 * h a < ⟪a, t⟫ ^ 2} ≤ ν (⋃ l : ℕ, {t | 1 ≤ ‖A l t‖}) :=
        measure_mono hsub
    _ = ⨆ l : ℕ, ν {t | 1 ≤ ‖A l t‖} := hmono.measure_iUnion
    _ ≤ _ := iSup_le hbound

end MinlosLemma

section WeakDual

variable {E : Type*} [AddCommGroup E] [Module ℝ E] [TopologicalSpace E] [IsTopologicalAddGroup E]
  [ContinuousSMul ℝ E]

variable [MeasurableSpace (WeakDual ℝ E)] [BorelSpace (WeakDual ℝ E)]

omit [IsTopologicalAddGroup E] [ContinuousSMul ℝ E] in
/-- **A Radon measure on the weak dual is determined by its Fourier transform** [Bourbaki, *INT*,
IX, §6, no. 3, Prop. 3 and §4, no. 2, Thm 1]: the evaluations `ω ↦ ω x` form a separating linear
family (`MeasureTheory.ext_of_forall_integral_cexp_eq`). No separability. -/
theorem ext_of_integral_cexp_eq {μ ν : Measure (WeakDual ℝ E)} [IsFiniteMeasure μ]
    [IsFiniteMeasure ν] [μ.InnerRegular] [ν.InnerRegular]
    (h : ∀ x, ∫ ω, cexp (ω x * I) ∂μ = ∫ ω, cexp (ω x * I) ∂ν) :
    μ = ν :=
  ext_of_forall_integral_cexp_eq (f := fun ω ↦ (WeakDual.toStrongDual ω).toLinearMap)
    WeakDual.coeFn_continuous (fun _ _ h ↦ ContinuousLinearMap.coe_injective h) h

/-- The evaluations `x ↦ (ω ↦ ω x)`, an additive family of continuous functions on the weak
dual. -/
noncomputable def evalAddMonoidHom : E →+ WeakDual ℝ E → ℝ where
  toFun x ω := ω x
  map_zero' := funext fun ω ↦ map_zero ω
  map_add' x y := funext fun ω ↦ map_add ω x y

omit [IsTopologicalAddGroup E] [ContinuousSMul ℝ E] in
/-- The Fourier transform of a finite measure on the weak dual is positive-definite. -/
theorem posSemidef_circulant_integral_cexp_weakDual (μ : Measure (WeakDual ℝ E))
    [IsFiniteMeasure μ] : (circulant fun x ↦ ∫ ω, cexp (ω x * I) ∂μ).PosSemidef :=
  posSemidef_circulant_integral_cexp μ evalAddMonoidHom fun x ↦
    (WeakDual.eval_continuous x).measurable

omit [ContinuousSMul ℝ E] in
/-- **On a barrelled space, the Fourier transform of a Radon measure on the weak dual is
continuous** [Bourbaki, *INT*, IX, §6, no. 8, Prop. 9]: a compact `K` carries all but `ε` of `μ`,
and is equicontinuous — `x ↦ sup_{ω ∈ K} |ω x|` is a lower semicontinuous, hence continuous,
seminorm — so `∫ (1 - cos ω x) dμ ≤ 2 ε + sup_{ω ∈ K} (ω x)² μ(E') / 2`. -/
theorem continuous_integral_cexp [BarrelledSpace ℝ E] (μ : Measure (WeakDual ℝ E))
    [IsFiniteMeasure μ] [μ.InnerRegular] : Continuous fun x ↦ ∫ ω, cexp (ω x * I) ∂μ := by
  set φ : E → ℂ := fun x ↦ ∫ ω, cexp (ω x * I) ∂μ with hφdef
  have hpd : (circulant φ).PosSemidef := posSemidef_circulant_integral_cexp_weakDual μ
  refine hpd.circulant_continuous ?_
  have hint : ∀ x, Integrable (fun ω : WeakDual ℝ E ↦ cexp (ω x * I)) μ := fun x ↦
    Integrable.of_bound ((continuous_ofReal.comp (WeakDual.eval_continuous x)).mul
      continuous_const).cexp.aestronglyMeasurable 1
      (Eventually.of_forall fun ω ↦ by rw [norm_exp_ofReal_mul_I])
  have hre : ∀ x, (φ x).re = ∫ ω, Real.cos (ω x) ∂μ := fun x ↦ by
    rw [hφdef]
    dsimp only
    rw [← Complex.reCLM_apply, ← Complex.reCLM.integral_comp_comm (hint x)]
    simp [Complex.exp_ofReal_mul_I_re]
  have hre0 : (φ 0).re = μ.real Set.univ := by
    rw [hre]
    simp
  -- `1 - Re φ` is at most `2 ε + p² μ(E') / 2` for the seminorm `p` of a compact `K`
  have hkey : ∀ ε > 0, ∃ p : Seminorm ℝ E, Continuous p ∧
      ∀ x, (φ 0).re - (φ x).re ≤ 2 * ε + p x ^ 2 * μ.real Set.univ / 2 := fun ε hε ↦ by
    obtain ⟨K, -, hK, hKε⟩ := MeasurableSet.univ.exists_isCompact_sdiff_lt (μ := μ)
      (measure_ne_top _ _) (ENNReal.ofReal_pos.2 hε).ne'
    set q : K → Seminorm ℝ E := fun ω ↦ (WeakDual.toStrongDual (ω : WeakDual ℝ E)).toLinearMap
      |>.toSeminorm with hq
    have hbdd : BddAbove (Set.range q) := Seminorm.bddAbove_range_iff.2 fun x ↦ by
      obtain ⟨C, hC⟩ := hK.bddAbove_image (f := fun ω : WeakDual ℝ E ↦ ‖ω x‖)
        ((WeakDual.eval_continuous x).norm.continuousOn)
      exact ⟨C, by rintro _ ⟨ω, rfl⟩; exact hC ⟨ω, ω.2, rfl⟩⟩
    refine ⟨⨆ ω, q ω, by
      rw [Seminorm.coe_iSup_eq hbdd]
      exact Seminorm.continuous_iSup q (fun ω ↦ by
        simpa [hq, LinearMap.coe_toSeminorm] using
          (WeakDual.toStrongDual (ω : WeakDual ℝ E)).continuous.norm) hbdd, fun x ↦ ?_⟩
    have hle : ∀ ω ∈ K, |ω x| ≤ (⨆ ω, q ω) x := fun ω hω ↦ by
      rw [Seminorm.iSup_apply hbdd]
      exact le_ciSup (f := fun ω ↦ q ω x) (Seminorm.bddAbove_range_iff.1 hbdd x) ⟨ω, hω⟩
    have hKc : MeasurableSet Kᶜ := hK.isClosed.measurableSet.compl
    have hpt : ∀ ω : WeakDual ℝ E, 1 - Real.cos (ω x) ≤
        2 * Kᶜ.indicator 1 ω + (⨆ ω, q ω) x ^ 2 / 2 := fun ω ↦ by
      by_cases hω : ω ∈ K
      · have h1 := Real.one_sub_sq_div_two_le_cos (x := ω x)
        have h2 : (ω x) ^ 2 ≤ (⨆ ω, q ω) x ^ 2 := by
          rw [← sq_abs]
          exact pow_le_pow_left₀ (abs_nonneg _) (hle ω hω) 2
        have h3 : 0 ≤ Kᶜ.indicator (1 : WeakDual ℝ E → ℝ) ω := Set.indicator_nonneg
          (fun _ _ ↦ zero_le_one) ω
        linarith
      · rw [Set.indicator_of_mem (Set.mem_compl hω), Pi.one_apply]
        have := Real.neg_one_le_cos (ω x)
        nlinarith [sq_nonneg ((⨆ ω, q ω) x)]
    have hcos : Integrable (fun ω : WeakDual ℝ E ↦ Real.cos (ω x)) μ :=
      Integrable.of_bound (Real.continuous_cos.comp
        (WeakDual.eval_continuous x)).aestronglyMeasurable 1
        (Eventually.of_forall fun ω ↦ by rw [Real.norm_eq_abs]; exact Real.abs_cos_le_one _)
    have hind : Integrable (fun ω ↦ 2 * Kᶜ.indicator (1 : WeakDual ℝ E → ℝ) ω) μ :=
      ((integrable_const (1 : ℝ)).indicator hKc).const_mul 2
    calc (φ 0).re - (φ x).re = ∫ ω, (1 - Real.cos (ω x)) ∂μ := by
          rw [hre0, hre, integral_sub (integrable_const 1) hcos, integral_const, smul_eq_mul,
            mul_one]
      _ ≤ ∫ ω, (2 * Kᶜ.indicator 1 ω + (⨆ ω, q ω) x ^ 2 / 2) ∂μ :=
          integral_mono ((integrable_const 1).sub hcos) (hind.add (integrable_const _)) hpt
      _ = 2 * μ.real Kᶜ + (⨆ ω, q ω) x ^ 2 * μ.real Set.univ / 2 := by
          rw [integral_add hind (integrable_const _), integral_const_mul,
            integral_indicator_one hKc, integral_const, smul_eq_mul]
          ring
      _ ≤ 2 * ε + (⨆ ω, q ω) x ^ 2 * μ.real Set.univ / 2 := by
          gcongr
          rw [Set.compl_eq_univ_sdiff]
          exact ENNReal.toReal_le_of_le_ofReal hε.le hKε.le
  -- continuity of `Re φ` at `0`
  rw [ContinuousAt]
  refine tendsto_order.2 ⟨fun a ha ↦ ?_, fun a ha ↦ Eventually.of_forall fun x ↦
    ((Complex.re_le_norm _).trans (hpd.circulant_norm_le x)).trans_lt ha⟩
  obtain ⟨p, hp, hpφ⟩ := hkey (((φ 0).re - a) / 4) (by linarith)
  have hp0 : Tendsto (fun x ↦ p x ^ 2 * μ.real Set.univ / 2) (𝓝 0) (𝓝 0) := by
    have := ((hp.tendsto 0).pow 2).mul_const (μ.real Set.univ) |>.div_const 2
    simpa using this
  filter_upwards [hp0.eventually (gt_mem_nhds (by linarith : (0 : ℝ) < ((φ 0).re - a) / 2))]
    with x hx
  linarith [hpφ x]

/-- **Minlos' theorem** [Bourbaki, *INT*, IX, §6, no. 10, Thm 2][bourbaki2004integration2]:
on a real topological vector space `E`, a positive-definite `φ` with `φ 0 = 1`, continuous for the
Sazonov topology — for every `ε > 0`, `1 - Re φ ≤ ε + ∑ₙ ωₙ²` with `ωₙ² ≤ cₙ² H`, `H` a
continuous positive quadratic form and `∑ₙ cₙ² < ∞` — is the Fourier transform of a Radon
probability measure on the weak dual. -/
theorem exists_isProbabilityMeasure_integral_cexp_eq {φ : E → ℂ}
    (hφ : (circulant φ).PosSemidef) (h0 : φ 0 = 1)
    (hS : ∀ ε > 0, ∃ (H : QuadraticForm ℝ E) (ω : ℕ → E →ₗ[ℝ] ℝ) (c : ℕ → ℝ),
      Continuous H ∧ (∀ x, 0 ≤ H x) ∧ Summable (fun n ↦ c n ^ 2) ∧
      (∀ n x, ω n x ^ 2 ≤ c n ^ 2 * H x) ∧ ∀ x, 1 - (φ x).re ≤ ε + ∑' n, ω n x ^ 2) :
    ∃ μ : Measure (WeakDual ℝ E), IsProbabilityMeasure μ ∧ μ.InnerRegular ∧
      ∀ x, ∫ ω, cexp (ω x * I) ∂μ = φ x := by
  classical
  -- the Sazonov bound `1 - Re φ ≤ ε + τ H`
  have hbound : ∀ ε > 0, ∃ (H : QuadraticForm ℝ E) (ω : ℕ → E →ₗ[ℝ] ℝ) (c : ℕ → ℝ),
      Continuous H ∧ (∀ x, 0 ≤ H x) ∧ Summable (fun n ↦ c n ^ 2) ∧
      (∀ n x, ω n x ^ 2 ≤ c n ^ 2 * H x) ∧ (∀ x, 1 - (φ x).re ≤ ε + ∑' n, ω n x ^ 2) ∧
      ∀ x, ∑' n, ω n x ^ 2 ≤ (∑' n, c n ^ 2) * H x := fun ε hε ↦ by
    obtain ⟨H, ω, c, hH, hpos, hc, hωc, hφS⟩ := hS ε hε
    refine ⟨H, ω, c, hH, hpos, hc, hωc, hφS, fun x ↦ ?_⟩
    rw [← tsum_mul_right]
    exact ((hc.mul_right (H x)).of_nonneg_of_le (fun n ↦ sq_nonneg _) (hωc · x)).tsum_le_tsum
      (hωc · x) (hc.mul_right _)
  have hre : ∀ x, (φ x).re ≤ 1 := fun x ↦
    (Complex.re_le_norm _).trans (by simpa [h0] using hφ.circulant_norm_le x)
  -- `φ` is continuous
  have hcont : Continuous φ := by
    refine hφ.circulant_continuous ?_
    rw [ContinuousAt, h0, Complex.one_re]
    refine tendsto_order.2 ⟨fun a ha ↦ ?_,
      fun a ha ↦ Eventually.of_forall fun x ↦ (hre x).trans_lt ha⟩
    obtain ⟨H, ω, c, hH, -, -, -, hφS, hτ⟩ := hbound ((1 - a) / 2) (by linarith)
    have hq : Tendsto (fun x ↦ (∑' n, c n ^ 2) * H x) (𝓝 0) (𝓝 0) := by
      have hc' : Continuous fun x ↦ (∑' n, c n ^ 2) * H x := continuous_const.mul hH
      simpa using hc'.tendsto (0 : E)
    filter_upwards [hq.eventually (gt_mem_nhds (by linarith : (0 : ℝ) < (1 - a) / 2))] with x hx
    linarith [hφS x, hτ x]
  -- the finite-dimensional marginals `ν J` on `ℝ^J`, by Bochner's theorem
  let X : ∀ J : Finset E, EuclideanSpace ℝ J →ₗ[ℝ] E := fun J ↦
    Fintype.linearCombination ℝ (fun j : J ↦ (j : E)) ∘ₗ (EuclideanSpace.equiv J ℝ).toLinearMap
  have hX : ∀ J s, X J s = ∑ j : J, s j • (j : E) := fun J s ↦
    Fintype.linearCombination_apply ℝ _ _
  have hXc : ∀ J, Continuous (X J) := fun J ↦ by
    simp_rw [funext (hX J)]
    exact continuous_finsetSum _ fun j _ ↦
      (EuclideanSpace.proj j).continuous.smul continuous_const
  have hB : ∀ J : Finset E, ∃ ν : Measure (EuclideanSpace ℝ J), IsProbabilityMeasure ν ∧
      charFun ν = fun s ↦ φ (X J s) := fun J ↦
    exists_isProbabilityMeasure_charFun_eq_iff.2
      ⟨hcont.comp (hXc J), hφ.circulant_comp (X J).toAddMonoidHom, by simp [h0]⟩
  choose ν hνp hνC using hB
  -- `charFunDual (ν J) L = φ (∑ⱼ L eⱼ • j)`, and how linear forms on `E` see that vector
  have hνL : ∀ (J : Finset E) (L : StrongDual ℝ (EuclideanSpace ℝ J)),
      charFunDual (ν J) L = φ (∑ j : J, L (EuclideanSpace.single j 1) • (j : E)) := fun J L ↦ by
    rw [← charFun_toDual_symm_eq_charFunDual, hνC J]
    dsimp only
    rw [hX]
    congr 1
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    congr 1
    rw [← InnerProductSpace.toDual_symm_apply, EuclideanSpace.inner_single_right, one_mul,
      conj_trivial]
  have hvec : ∀ (J : Finset E) (M : StrongDual ℝ (EuclideanSpace ℝ J)) (ℓ : E →ₗ[ℝ] ℝ),
      ℓ (∑ j : J, M (EuclideanSpace.single j 1) • (j : E)) =
        M (WithLp.toLp 2 fun j : J ↦ ℓ (j : E)) :=
    fun J M ℓ ↦ by
      conv_rhs => rw [← (EuclideanSpace.basisFun J ℝ).sum_repr
        (WithLp.toLp 2 fun j : J ↦ ℓ (j : E))]
      simp [map_sum, map_smul, EuclideanSpace.basisFun_apply, mul_comm]
  -- `P J`, the marginals on `J → ℝ`, form a projective family
  set P : ∀ J : Finset E, Measure (∀ _ : J, ℝ) := fun J ↦ (ν J).map (EuclideanSpace.equiv J ℝ)
    with hP
  have hPp : ∀ J, IsProbabilityMeasure (P J) := fun J ↦ by
    have := hνp J
    change IsProbabilityMeasure ((ν J).map (EuclideanSpace.equiv J ℝ))
    infer_instance
  have hproj : IsProjectiveMeasureFamily (α := fun _ : E ↦ ℝ) P := fun I J hJI ↦ by
    let R : EuclideanSpace ℝ I →L[ℝ] EuclideanSpace ℝ J :=
      (EuclideanSpace.equiv J ℝ).symm.toContinuousLinearMap ∘L
        (ContinuousLinearMap.pi fun j : J ↦ ContinuousLinearMap.proj ⟨j.1, hJI j.2⟩) ∘L
          (EuclideanSpace.equiv I ℝ).toContinuousLinearMap
    have hR : (EuclideanSpace.equiv J ℝ) ∘ R =
        Finset.restrict₂ (π := fun _ : E ↦ ℝ) hJI ∘ EuclideanSpace.equiv I ℝ := by
      funext x
      rfl
    have hνR : ν J = (ν I).map R := by
      refine Measure.ext_of_charFunDual (funext fun L ↦ ?_)
      rw [charFunDual_map, hνL, hνL]
      congr 1
      rw [← sub_eq_zero, ← Module.forall_dual_apply_eq_zero_iff ℝ]
      intro ℓ
      rw [map_sub, sub_eq_zero, hvec J L ℓ, hvec I (L.comp R) ℓ]
      rfl
    change (ν J).map (EuclideanSpace.equiv J ℝ) =
      ((ν I).map (EuclideanSpace.equiv I ℝ)).map (Finset.restrict₂ (π := fun _ : E ↦ ℝ) hJI)
    rw [hνR, Measure.map_map (EuclideanSpace.equiv J ℝ).continuous.measurable
      R.continuous.measurable, hR]
    exact (Measure.map_map (Finset.measurable_restrict₂ hJI)
      (EuclideanSpace.equiv I ℝ).continuous.measurable).symm
  -- tightness: the weak-* ellipsoids `{ω² ≤ r² H}` carry all but `ε` of every marginal
  set π : ∀ J : Finset E, WeakDual ℝ E → (∀ _ : J, ℝ) := fun J ω ↦ J.restrict fun x ↦ ω x
    with hπdef
  have hπ : ∀ J, Continuous (π J) := fun J ↦
    (Finset.continuous_restrict J).comp WeakDual.coeFn_continuous
  have htight : ∀ ε > 0, ∃ K, IsCompact K ∧ ∀ J, P J (π J '' K)ᶜ ≤ ε := fun ε hε ↦ by
    obtain ⟨η, hη0, hηε⟩ : ∃ η : ℝ, 0 < η ∧ ENNReal.ofReal η ≤ ε := by
      obtain ⟨r, -, hr0, hrε⟩ := ENNReal.lt_iff_exists_real_btwn.1 hε
      exact ⟨r, ENNReal.ofReal_pos.1 hr0, hrε.le⟩
    obtain ⟨H, ω, c, hH, hpos, hc, hωc, hφS, -⟩ := hbound (η / 6) (by positivity)
    set τ := ∑' n, c n ^ 2 with hτ
    have hτ0 : 0 ≤ τ := tsum_nonneg fun _ ↦ sq_nonneg _
    set r := √(6 * τ / η + 1) with hr
    have hr0 : 0 < r := Real.sqrt_pos.2 (by positivity)
    have hr2 : r ^ 2 = 6 * τ / η + 1 := Real.sq_sqrt (by positivity)
    refine ⟨{ω : WeakDual ℝ E | ∀ x, ω x ^ 2 ≤ r ^ 2 * H x},
      WeakDual.isCompact_setOf_forall_sq_le hH r, fun J ↦ ?_⟩
    have hK : IsCompact (π J '' {ω : WeakDual ℝ E | ∀ x, ω x ^ 2 ≤ r ^ 2 * H x}) :=
      (WeakDual.isCompact_setOf_forall_sq_le hH r).image (hπ J)
    -- the inner product with `wₙ = (ωₙ j)ⱼ` is `ωₙ ∘ X J`
    have hw : ∀ n a, ⟪WithLp.toLp 2 (fun j : J ↦ ω n j), a⟫ = ω n (X J a) := fun n a ↦ by
      rw [hX, map_sum, PiLp.inner_apply]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      simp
    have hlemma := measure_setOf_exists_lt_inner_sq_le (ν := ν J) (h := H.comp (X J))
      (fun a ↦ hpos _) hc (w := fun n ↦ WithLp.toLp 2 (fun j : J ↦ ω n j))
      (fun n a ↦ by rw [hw]; exact hωc n _)
      (fun a ↦ by
        rw [hνC J]
        simp_rw [hw]
        exact hφS _) hr0
    calc P J (π J '' {ω : WeakDual ℝ E | ∀ x, ω x ^ 2 ≤ r ^ 2 * H x})ᶜ
        = ν J ((EuclideanSpace.equiv J ℝ) ⁻¹'
            (π J '' {ω : WeakDual ℝ E | ∀ x, ω x ^ 2 ≤ r ^ 2 * H x})ᶜ) :=
          Measure.map_apply (EuclideanSpace.equiv J ℝ).continuous.measurable
            hK.isClosed.measurableSet.compl
      _ ≤ ν J {t | ∃ a, r ^ 2 * (H.comp (X J)) a < ⟪a, t⟫ ^ 2} := by
          refine measure_mono fun t ht ↦ ?_
          by_contra hne
          simp only [Set.mem_ofPred_eq, not_exists, not_lt] at hne
          obtain ⟨ω', hω', hω'j⟩ := WeakDual.exists_forall_sq_le_and_apply_eq hH hpos hr0.le
            (J := J) (t := EuclideanSpace.equiv J ℝ t) fun a ↦ by
              have := hne (WithLp.toLp 2 a)
              rw [QuadraticMap.comp_apply, hX] at this
              convert this using 2
              case e'_3 => simp [PiLp.inner_apply, mul_comm]
          exact ht ⟨ω', hω', funext hω'j⟩
      _ ≤ ENNReal.ofReal (3 * (η / 6 + τ / r ^ 2)) := hlemma
      _ ≤ ENNReal.ofReal η := by
          refine ENNReal.ofReal_le_ofReal ?_
          rw [hr2]
          have : τ / (6 * τ / η + 1) ≤ η / 6 := by
            rw [div_le_iff₀ (by positivity)]
            field_simp
            nlinarith
          linarith
      _ ≤ ε := hηε
  -- Prokhorov: the limit measure
  obtain ⟨μ, hμfin, hμR, -, hμmarg⟩ := hproj.exists_map_restrict_eq (X := WeakDual ℝ E)
    (f := fun ω x ↦ ω x) WeakDual.coeFn_continuous DFunLike.coe_injective htight
  have : IsProbabilityMeasure μ := by
    constructor
    have := congrArg (· Set.univ) (hμmarg ∅)
    rw [Measure.map_apply (hπ ∅).measurable MeasurableSet.univ, Set.preimage_univ] at this
    rw [this]
    exact measure_univ
  refine ⟨μ, inferInstance, hμR, fun x ↦ ?_⟩
  -- the Fourier transform, from the marginal on `{x}`
  set J : Finset E := {x}
  have hx : x ∈ J := Finset.mem_singleton_self x
  have hint : ∫ ω, cexp (ω x * I) ∂μ =
      ∫ s, cexp ((EuclideanSpace.proj (⟨x, hx⟩ : J) s : ℝ) * I) ∂(ν J) := by
    have h1 : ∫ ω, cexp (ω x * I) ∂μ = ∫ t, cexp (t ⟨x, hx⟩ * I) ∂(μ.map (π J)) := by
      rw [integral_map (hπ J).measurable.aemeasurable
        (Continuous.aestronglyMeasurable (by fun_prop))]
      rfl
    rw [h1, hμmarg J, integral_map (EuclideanSpace.equiv J ℝ).continuous.measurable.aemeasurable
      (Continuous.aestronglyMeasurable (by fun_prop))]
    rfl
  rw [hint, ← charFunDual_apply, hνL J]
  congr 1
  rw [← sub_eq_zero, ← Module.forall_dual_apply_eq_zero_iff ℝ]
  intro ℓ
  rw [map_sub, sub_eq_zero, hvec J]
  rfl

/-- **Minlos' theorem on a nuclear space** [Bourbaki, *INT*, IX, §6, no. 10, Thm 2 and
Cor.][bourbaki2004integration2]: on a real locally convex nuclear space, a continuous
positive-definite `φ` with `φ 0 = 1` is the Fourier transform of a Radon probability measure on
the weak dual. Continuity at `0` gives a continuous seminorm `p` with `1 - Re φ ≤ ε + 2 p²`, and
nuclearity dominates `p²` by a nuclear quadratic form (`NuclearSpace.exists_sq_le_tsum_sq`). -/
theorem exists_isProbabilityMeasure_integral_cexp_eq_of_continuous [LocallyConvexSpace ℝ E]
    [NuclearSpace ℝ E] {φ : E → ℂ} (hc : Continuous φ) (hφ : (circulant φ).PosSemidef)
    (h0 : φ 0 = 1) :
    ∃ μ : Measure (WeakDual ℝ E), IsProbabilityMeasure μ ∧ μ.InnerRegular ∧
      ∀ x, ∫ ω, cexp (ω x * I) ∂μ = φ x := by
  refine exists_isProbabilityMeasure_integral_cexp_eq hφ h0 fun ε hε ↦ ?_
  -- a continuous seminorm `p₀` whose `r`-ball lies in `{1 - Re φ < ε}`
  have hU : {x | 1 - (φ x).re < ε} ∈ 𝓝 (0 : E) :=
    (isOpen_lt (continuous_const.sub (continuous_re.comp hc)) continuous_const).mem_nhds
      (by simp [h0, hε])
  obtain ⟨⟨t, r⟩, hr, htU⟩ := (PolynormableSpace.withSeminorms ℝ E).hasBasis_zero_ball.mem_iff.1 hU
  dsimp only at hr htU
  set p₀ : Seminorm ℝ E := t.sup fun p : {p : Seminorm ℝ E // Continuous p} ↦ p.1 with hp₀
  have hp₀c : Continuous p₀ := Seminorm.continuous_finsetSup fun i _ ↦ i.2
  have hle : ∀ x, 1 - (φ x).re ≤ ε + 2 / r ^ 2 * p₀ x ^ 2 := fun x ↦ by
    have hre : -1 ≤ (φ x).re := by
      have := (Complex.abs_re_le_norm (φ x)).trans (by simpa [h0] using hφ.circulant_norm_le x)
      linarith [abs_le.1 this]
    rcases lt_or_ge (p₀ x) r with hx | hx
    · have : 1 - (φ x).re < ε := htU (by rwa [Seminorm.mem_ball_zero])
      have : 0 ≤ 2 / r ^ 2 * p₀ x ^ 2 := by positivity
      linarith
    · have h1 : 1 ≤ p₀ x ^ 2 / r ^ 2 := by
        rw [le_div_iff₀ (by positivity), one_mul]
        exact pow_le_pow_left₀ hr.le hx 2
      have : 2 ≤ 2 / r ^ 2 * p₀ x ^ 2 := by
        rw [div_mul_eq_mul_div, mul_div_assoc]
        linarith
      linarith
  -- nuclearity: `p₀² ≤ ∑ₙ ωₙ²` with `ωₙ² ≤ cₙ² H`
  obtain ⟨H, ω, c, hH, hpos, hc2, hωc, hp₀ω⟩ := NuclearSpace.exists_sq_le_tsum_sq hp₀c
  have hk : 0 ≤ 2 / r ^ 2 := by positivity
  refine ⟨H, fun n ↦ √(2 / r ^ 2) • (ω n).toLinearMap, fun n ↦ √(2 / r ^ 2) * c n, hH, hpos,
    ?_, fun n x ↦ ?_, fun x ↦ ?_⟩
  · exact (hc2.mul_left (2 / r ^ 2)).congr fun n ↦ by rw [mul_pow, Real.sq_sqrt hk]
  · simp only [LinearMap.smul_apply, ContinuousLinearMap.coe_coe, smul_eq_mul, mul_pow,
      Real.sq_sqrt hk, mul_assoc]
    exact mul_le_mul_of_nonneg_left (hωc n x) hk
  · have hsum : ∑' n, (√(2 / r ^ 2) • (ω n).toLinearMap) x ^ 2 = 2 / r ^ 2 * ∑' n, ω n x ^ 2 := by
      simp only [LinearMap.smul_apply, ContinuousLinearMap.coe_coe, smul_eq_mul, mul_pow,
        Real.sq_sqrt hk, tsum_mul_left]
    rw [hsum]
    exact (hle x).trans (by gcongr; exact hp₀ω x)

/-- **The Bochner–Minlos theorem** [Bourbaki, *INT*, IX, §6, no. 12,
Cor.][bourbaki2004integration2]: on a real barrelled nuclear locally convex space, `φ` is the
Fourier transform of a Radon probability measure on the weak dual iff it is continuous and
positive-definite with `φ 0 = 1`. The measure is unique
(`MeasureTheory.ext_of_integral_cexp_eq`). -/
theorem exists_isProbabilityMeasure_integral_cexp_eq_iff [LocallyConvexSpace ℝ E]
    [NuclearSpace ℝ E] [BarrelledSpace ℝ E] {φ : E → ℂ} :
    (∃ μ : Measure (WeakDual ℝ E), IsProbabilityMeasure μ ∧ μ.InnerRegular ∧
        ∀ x, ∫ ω, cexp (ω x * I) ∂μ = φ x) ↔
      Continuous φ ∧ (circulant φ).PosSemidef ∧ φ 0 = 1 := by
  refine ⟨fun ⟨μ, _, _, hμ⟩ ↦ ?_, fun ⟨hc, hφ, h0⟩ ↦
    exists_isProbabilityMeasure_integral_cexp_eq_of_continuous hc hφ h0⟩
  have hφμ : φ = fun x ↦ ∫ ω, cexp (ω x * I) ∂μ := funext fun x ↦ (hμ x).symm
  subst hφμ
  exact ⟨continuous_integral_cexp μ, posSemidef_circulant_integral_cexp_weakDual μ,
    by simp⟩

/-- **The Bochner–Minlos theorem for finite measures** [Bourbaki, *INT*, IX, §6, no. 12,
Cor.][bourbaki2004integration2]: on a real barrelled nuclear locally convex space, `φ` is the
Fourier transform of a finite Radon measure on the weak dual iff it is continuous and
positive-definite. -/
theorem exists_integral_cexp_eq_iff [LocallyConvexSpace ℝ E] [NuclearSpace ℝ E]
    [BarrelledSpace ℝ E] {φ : E → ℂ} :
    (∃ μ : Measure (WeakDual ℝ E), IsFiniteMeasure μ ∧ μ.InnerRegular ∧
        ∀ x, ∫ ω, cexp (ω x * I) ∂μ = φ x) ↔
      Continuous φ ∧ (circulant φ).PosSemidef := by
  refine ⟨fun ⟨μ, _, _, hμ⟩ ↦ ?_, fun ⟨hc, hφ⟩ ↦ ?_⟩
  · have hφμ : φ = fun x ↦ ∫ ω, cexp (ω x * I) ∂μ := funext fun x ↦ (hμ x).symm
    subst hφμ
    exact ⟨continuous_integral_cexp μ, posSemidef_circulant_integral_cexp_weakDual μ⟩
  -- `φ 0 = c ≥ 0`: `φ = 0` if `c = 0`, and `φ / c` is normalized otherwise
  obtain ⟨hre, him⟩ := Complex.nonneg_iff.1 hφ.circulant_zero_nonneg
  set c := (φ 0).re with hc_def
  have hφ0 : φ 0 = c := Complex.ext rfl him.symm
  rcases hre.eq_or_lt with h0 | hpos
  · have hφz : φ = 0 := funext fun x ↦
      norm_le_zero_iff.1 ((hφ.circulant_norm_le x).trans h0.symm.le)
    exact ⟨0, inferInstance, inferInstance, fun x ↦ by simp [hφz]⟩
  obtain ⟨μ, hμp, hμR, hμ⟩ := exists_isProbabilityMeasure_integral_cexp_eq_of_continuous
    (φ := c⁻¹ • φ) (hc.const_smul c⁻¹)
    (by rw [circulant_smul]; exact hφ.smul (inv_nonneg.2 hre))
    (by rw [Pi.smul_apply, hφ0, Complex.real_smul, ← ofReal_mul, inv_mul_cancel₀ hpos.ne',
      ofReal_one])
  refine ⟨c.toNNReal • μ, inferInstance, inferInstance, fun x ↦ ?_⟩
  rw [integral_smul_nnreal_measure, hμ x, NNReal.smul_def, Real.coe_toNNReal _ hre,
    Pi.smul_apply, smul_smul, mul_inv_cancel₀ hpos.ne', one_smul]

/-- **Gaussian measures on the dual of a nuclear space** [Bourbaki, *INT*, IX, §6, nos. 5 and
10][bourbaki2004integration2]: a continuous positive quadratic form `Q` on a real locally convex
nuclear space is the covariance of a Gaussian Radon probability measure on the weak dual, with
Fourier transform `exp (-Q / 2)` and every `ω ↦ ω x` centred Gaussian of variance `Q x`. On
`𝓢(ℝᵈ, ℝ)` with `Q f = ⟪f, (m² - Δ)⁻¹ f⟫` this is the Euclidean free field. -/
theorem exists_isProbabilityMeasure_map_eq_gaussianReal [LocallyConvexSpace ℝ E]
    [NuclearSpace ℝ E] {Q : QuadraticForm ℝ E} (hQ : Continuous Q) (hpos : ∀ x, 0 ≤ Q x) :
    ∃ μ : Measure (WeakDual ℝ E), IsProbabilityMeasure μ ∧ μ.InnerRegular ∧
      (∀ x, ∫ ω, cexp (ω x * I) ∂μ = Real.exp (-(Q x / 2))) ∧
      ∀ x, μ.map (fun ω ↦ ω x) = gaussianReal 0 (Q x).toNNReal := by
  obtain ⟨μ, hμp, hμR, hμ⟩ := exists_isProbabilityMeasure_integral_cexp_eq_of_continuous
    (φ := fun x ↦ (Real.exp (-(Q x / 2)) : ℂ))
    (continuous_ofReal.comp (Real.continuous_exp.comp (hQ.div_const 2).neg))
    (posSemidef_circulant_exp_neg_half hpos) (by simp)
  refine ⟨μ, hμp, hμR, hμ, fun x ↦ Measure.ext_of_charFun (funext fun t ↦ ?_)⟩
  have hx : Measurable fun ω : WeakDual ℝ E ↦ ω x := (WeakDual.eval_continuous x).measurable
  rw [charFun_apply_real, integral_map hx.aemeasurable
    (Continuous.aestronglyMeasurable (by fun_prop)), charFun_gaussianReal]
  have ht : ∀ ω : WeakDual ℝ E, cexp (t * (ω x : ℂ) * I) = cexp (ω (t • x) * I) := fun ω ↦ by
    rw [map_smul, smul_eq_mul, ofReal_mul]
  simp_rw [ht, hμ, QuadraticMap.map_smul, smul_eq_mul, Real.coe_toNNReal _ (hpos x),
    ofReal_exp]
  congr 1
  push_cast
  ring

end WeakDual

end MeasureTheory
